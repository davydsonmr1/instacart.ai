# ============================================
# InstaCart AI — Environment Variables (backend)
# ============================================
# Copy this file to backend/.env and fill in your values.

# Server
NODE_ENV=development
PORT=3333

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting (defaults usados pelo @nestjs/throttler nas tasks futuras)
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=30

# Supabase — SERVICE_ROLE_KEY é secret, nunca expor no frontend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage (bucket para imagens de produto)
SUPABASE_STORAGE_BUCKET=product-images

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
